package api

import (
	"encoding/json"

	"github.com/devplatform/api/internal/builder"
	"github.com/devplatform/api/internal/db"
	"github.com/gin-gonic/gin"
	"github.com/google/uuid"
)

type Handler struct {
	domain string
}

type CreateProjectReq struct {
	Name     string `json:"name" binding:"required"`
	GitRepo  string `json:"git_repo" binding:"required"`
	GitBranch string `json:"git_branch"`
	EnvVars  map[string]string `json:"env_vars"`
}

type DeployReq struct {
	Branch   string `json:"branch"`
	CommitSHA string `json:"commit_sha"`
}

func (h *Handler) ListProjects(c *gin.Context) {
	rows, err := db.Pool().Query(`SELECT id, name, git_repo, git_branch, created_at, updated_at FROM projects ORDER BY created_at DESC`)
	if err != nil {
		c.JSON(500, gin.H{"error": err.Error()})
		return
	}
	defer rows.Close()

	type Project struct {
		ID        string `json:"id"`
		Name      string `json:"name"`
		GitRepo   string `json:"git_repo"`
		GitBranch string `json:"git_branch"`
		CreatedAt string `json:"created_at"`
		UpdatedAt string `json:"updated_at"`
		Status    string `json:"status"`
	}

	var projects []Project
	for rows.Next() {
		var p Project
		if err := rows.Scan(&p.ID, &p.Name, &p.GitRepo, &p.GitBranch, &p.CreatedAt, &p.UpdatedAt); err != nil {
			continue
		}
		row := db.Pool().QueryRow(`SELECT status FROM deployments WHERE project_id = $1 ORDER BY created_at DESC LIMIT 1`, p.ID)
		row.Scan(&p.Status)
		if p.Status == "" {
			p.Status = "inactive"
		}
		projects = append(projects, p)
	}
	if projects == nil {
		projects = []Project{}
	}
	c.JSON(200, projects)
}

func (h *Handler) CreateProject(c *gin.Context) {
	var req CreateProjectReq
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(400, gin.H{"error": err.Error()})
		return
	}

	envVarsJSON, err := json.Marshal(req.EnvVars)
	if err != nil {
		c.JSON(500, gin.H{"error": "invalid env vars"})
		return
	}

	var id string
	err = db.Pool().QueryRow(
		`INSERT INTO projects (name, git_repo, git_branch, env_vars) VALUES ($1, $2, $3, $4::jsonb) RETURNING id`,
		req.Name, req.GitRepo, req.GitBranch, string(envVarsJSON),
	).Scan(&id)
	if err != nil {
		c.JSON(500, gin.H{"error": err.Error()})
		return
	}

	c.JSON(201, gin.H{"id": id, "name": req.Name, "git_repo": req.GitRepo})
}

func (h *Handler) GetProject(c *gin.Context) {
	id := c.Param("id")
	var p struct {
		ID        string `json:"id"`
		Name      string `json:"name"`
		GitRepo   string `json:"git_repo"`
		GitBranch string `json:"git_branch"`
		CreatedAt string `json:"created_at"`
		UpdatedAt string `json:"updated_at"`
	}
	err := db.Pool().QueryRow(
		`SELECT id, name, git_repo, git_branch, created_at, updated_at FROM projects WHERE id = $1`, id,
	).Scan(&p.ID, &p.Name, &p.GitRepo, &p.GitBranch, &p.CreatedAt, &p.UpdatedAt)
	if err != nil {
		c.JSON(404, gin.H{"error": "project not found"})
		return
	}
	c.JSON(200, p)
}

func (h *Handler) DeleteProject(c *gin.Context) {
	id := c.Param("id")
	if _, err := db.Pool().Exec(`DELETE FROM projects WHERE id = $1`, id); err != nil {
		c.JSON(500, gin.H{"error": err.Error()})
		return
	}
	c.JSON(200, gin.H{"message": "deleted"})
}

func (h *Handler) TriggerDeploy(c *gin.Context) {
	projectID := c.Param("id")

	var req DeployReq
	c.ShouldBindJSON(&req)

	var project struct {
		Name     string
		GitRepo  string
		GitBranch string
	}
	err := db.Pool().QueryRow(
		`SELECT name, git_repo, git_branch FROM projects WHERE id = $1`, projectID,
	).Scan(&project.Name, &project.GitRepo, &project.GitBranch)
	if err != nil {
		c.JSON(404, gin.H{"error": "project not found"})
		return
	}

	branch := req.Branch
	if branch == "" {
		branch = project.GitBranch
	}

	deployID := uuid.New().String()
	domain := project.Name + "." + h.domain

	_, err = db.Pool().Exec(
		`INSERT INTO deployments (id, project_id, status, branch, commit_sha, domain) VALUES ($1, $2, 'queued', $3, $4, $5)`,
		deployID, projectID, branch, req.CommitSHA, domain,
	)
	if err != nil {
		c.JSON(500, gin.H{"error": err.Error()})
		return
	}

	go builder.RunBuild(projectID, deployID, project.Name, project.GitRepo, branch)

	c.JSON(202, gin.H{
		"deployment_id": deployID,
		"project_id":    projectID,
		"status":        "queued",
		"domain":        domain,
	})
}

func (h *Handler) GetDeployment(c *gin.Context) {
	id := c.Param("id")
	var d struct {
		ID        string `json:"id"`
		ProjectID string `json:"project_id"`
		Status    string `json:"status"`
		Branch    string `json:"branch"`
		CommitSHA string `json:"commit_sha"`
		Logs      string `json:"logs"`
		Domain    string `json:"domain"`
		CreatedAt string `json:"created_at"`
		UpdatedAt string `json:"updated_at"`
	}
	err := db.Pool().QueryRow(
		`SELECT id, project_id, status, branch, commit_sha, logs, domain, created_at, updated_at FROM deployments WHERE id = $1`, id,
	).Scan(&d.ID, &d.ProjectID, &d.Status, &d.Branch, &d.CommitSHA, &d.Logs, &d.Domain, &d.CreatedAt, &d.UpdatedAt)
	if err != nil {
		c.JSON(404, gin.H{"error": "deployment not found"})
		return
	}
	c.JSON(200, d)
}

func (h *Handler) ListDeployments(c *gin.Context) {
	projectID := c.Param("id")
	rows, err := db.Pool().Query(
		`SELECT id, status, branch, domain, created_at FROM deployments WHERE project_id = $1 ORDER BY created_at DESC LIMIT 20`, projectID,
	)
	if err != nil {
		c.JSON(500, gin.H{"error": err.Error()})
		return
	}
	defer rows.Close()

	type Deployment struct {
		ID        string `json:"id"`
		Status    string `json:"status"`
		Branch    string `json:"branch"`
		Domain    string `json:"domain"`
		CreatedAt string `json:"created_at"`
	}

	var deployments []Deployment
	for rows.Next() {
		var d Deployment
		if err := rows.Scan(&d.ID, &d.Status, &d.Branch, &d.Domain, &d.CreatedAt); err != nil {
			continue
		}
		deployments = append(deployments, d)
	}
	if deployments == nil {
		deployments = []Deployment{}
	}
	c.JSON(200, deployments)
}

